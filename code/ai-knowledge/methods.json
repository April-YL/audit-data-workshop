        ]
      },
      "required_parameters": [
        {
          "name": "region",
          "meaning": "列范围与明细起止行",
          "required": true,
          "default": null,
          "blocking_if_missing": true
        },
        {
          "name": "header_rows",
          "meaning": "表头行及字段生成方式",
          "required": true,
          "default": null,
          "blocking_if_missing": true
        },
        {
          "name": "merge_policy",
          "meaning": "允许展开的合并区域和列",
          "required": true,
          "default": null,
          "blocking_if_missing": true
        },
        {
          "name": "summary_policy",
          "meaning": "合计说明及空白行的识别与去向",
          "required": true,
          "default": null,
          "blocking_if_missing": true
        }
      ],
      "clarification_questions": [
        "哪些是明细、标题和合计？",
        "普通空白是否保留？"
      ],
      "steps": [
        {
          "order": 1,
          "action": "识别并展示候选区域"
        },
        {
          "order": 2,
          "action": "确认表头与明细边界"
        },
        {
          "order": 3,
          "action": "按真实合并区域生成字段；补值限确认范围"
        },
        {
          "order": 4,
          "action": "保留原始网格及排除记录"
