      ],
      "effects": [
        "字段和记录数可能变化；来源不变"
      ],
      "exceptions": [
        {
          "condition": "表头重名或为空",
          "destination": "结构问题",
          "action": "暂停确认"
        },
        {
          "condition": "区域截断合并单元格",
          "destination": "结构问题",
          "action": "拒绝该方案"
        }
      ],
      "review_requirements": [
        "逐列核对层级及原始位置",
        "明细与排除记录均能定位"
      ],
      "source_refs": [
        {
          "source_id": "src.design",
          "section": "通用方法设计"
        },
        {
          "source_id": "src.local-contract",
          "section": "第4—7节"
        }
      ],
